{
  "name": "astro-notionfolio",
  "type": "module",
  "private": true,
  "description": "Notion-inspired Astro + TypeScript + Tailwind portfolio, configured from site.config.ts.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "a11y": "node scripts/axe-audit.mjs",
    "astro": "astro",
    "audit:post": "npm run sync && mkdir -p .audit && AUDIT_REPORTS=1 astro build",
    "build": "npm run sync && astro check && astro build && pagefind --site dist",
    "build:fast": "npm run sync && astro build && pagefind --site dist",
    "covers": "node scripts/generate-blog-covers.mjs",
    "covers:all": "node scripts/generate-blog-covers.mjs --site --collections --pages",
    "covers:ensure": "node scripts/ensure-blog-covers.mjs",
    "dev": "npm run sync && astro dev",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "prettier --check . && astro check && node scripts/check-tokens.mjs",
    "logos:pkg": "node scripts/generate-pkg-logo-srcset.mjs",
    "optimize:icons": "svgo --config scripts/svgo.config.cjs -f public/media/icons/tech -o public/media/icons/tech",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "preview": "astro preview",
    "seo:audit": "node scripts/run-seo-audit.mjs",
    "shots": "node scripts/generate-project-shots.mjs",
    "start": "npm run dev",
    "sync": "node scripts/sync-config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "maplibre-gl": "^6.13.0",
    "marked": "^18.1.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "sanitize-html": "^2.18.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@casoon/astro-post-audit": "0.9.1",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.14.0",
    "js-yaml": "^5.4.3",
    "lucide-static": "^1.53.0",
    "pagefind": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "puppeteer": "^25.13.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  }
}
